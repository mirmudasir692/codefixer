{
  "name": "codefixer",
  "version": "0.1.0",
  "description": "A terminal coding agent powered by Mirascope and local Ollama models.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "codefixer": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirmudasir692/codefixer.git"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-assistant",
    "ollama",
    "mirascope",
    "llm",
    "qwen"
  ],
  "bugs": {
    "url": "https://github.com/mirmudasir692/codefixer/issues"
  },
  "homepage": "https://github.com/mirmudasir692/codefixer#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@google/genai": "^3.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/propagator-aws-xray": "^3.0.0",
    "@opentelemetry/propagator-b3": "^2.12.0",
    "@opentelemetry/propagator-jaeger": "^2.12.0",
    "@opentelemetry/propagator-ot-trace": "^0.30.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "mirascope": "^2.8.2-alpha.0",
    "openai": "^7.53.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
